---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Icon from "../components/ui/Icon.astro";
import TextReveal from "../components/ui/TextReveal.astro";
import duck from "../assets/duck.jpg";
---

<!-- easter egg: linked from "Ducks" in the interest cloud -->
<Base title="Ducks" description="A duck.">
  <section class="ducks container">
    <h1><TextReveal text="quack." /></h1>
    <figure>
      <Image src={duck} alt="A male mallard duck swimming on calm blue water" widths={[640, 1280]} sizes="(max-width: 52rem) 100vw, 52rem" />
      <figcaption>
        Photo: <a href="https://commons.wikimedia.org/wiki/File:Mallard_Duck_(Unsplash).jpg" target="_blank" rel="noopener noreferrer">Wikimedia Commons</a>, CC0
      </figcaption>
    </figure>
    <a href="/" class="btn btn-primary">Back home <Icon name="arrow-right" /></a>
  </section>
</Base>

<style>
  .ducks {
    min-height: 90svh;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 2rem;
    text-align: center;
    padding-block: 7rem 4rem;
  }

  h1 {
    font-size: clamp(4rem, 14vw, 8rem);
    line-height: 0.9;
  }

  figure {
    margin: 0;
    max-width: 52rem;
  }

  figure img {
    width: 100%;
    height: auto;
    border-radius: var(--r-lg);
    box-shadow: 0 30px 80px -30px var(--glow);
  }

  figcaption {
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-faint);
  }
</style>
