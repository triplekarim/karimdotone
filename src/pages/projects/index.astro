---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/layout/PageHeader.astro";
import ProjectCard from "../../components/ui/ProjectCard.astro";
import { getProjects } from "../../lib/content";

const projects = await getProjects();
---

<Base title="Projects" description="Things Karim has built.">
  <PageHeader title="Projects." lead="Selected work." />
  <section class="container section-tight">
    <div class="grid" data-reveal-stagger>
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</Base>

<style>
  .section-tight {
    padding-bottom: calc(var(--section-gap) / 2);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  /* the first project (tripleManta) takes two columns */
  .grid > :global(:first-child) {
    grid-column: span 2;
  }

  @media (max-width: 52rem) {
    .grid {
      grid-template-columns: 1fr;
    }

    .grid > :global(:first-child) {
      grid-column: auto;
    }
  }
</style>
