---
/** Small stroke icon set (24×24 grid). */
const PATHS = {
  "arrow-right": ["M5 12h14", "M13 6l6 6-6 6"],
  "arrow-up-right": ["M7 17 17 7", "M8 7h9v9"],
  mail: ["M3 6.5A1.5 1.5 0 0 1 4.5 5h15A1.5 1.5 0 0 1 21 6.5v11a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5z", "m3.5 6.5 8.5 6 8.5-6"],
  github: [
    "M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4",
    "M9 18c-4.51 2-5-2-7-2",
  ],
  pin: ["M12 21.5s7-6.1 7-11.5a7 7 0 1 0-14 0c0 5.4 7 11.5 7 11.5z", "M12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z"],
  cap: ["M2 9.5 12 5l10 4.5L12 14z", "M6 11.5v4.5c0 1.66 2.69 3 6 3s6-1.34 6-3v-4.5", "M22 9.5V15"],
  rss: ["M4 11a9 9 0 0 1 9 9", "M4 4a16 16 0 0 1 16 16", "M5 20a1 1 0 1 0 0-2 1 1 0 0 0 0 2z"],
  gamepad: [
    "M6 11h4",
    "M8 9v4",
    "M15 12h.01",
    "M18 10h.01",
    "M17.32 5H6.68a4 4 0 0 0-3.98 3.59l-.69 6.1A2.5 2.5 0 0 0 4.5 17.5c.83 0 1.6-.41 2.06-1.1L8 14h8l1.44 2.4c.46.69 1.23 1.1 2.06 1.1a2.5 2.5 0 0 0 2.49-2.81l-.69-6.1A4 4 0 0 0 17.32 5z",
  ],
} as const;

export type IconName = keyof typeof PATHS;

interface Props {
  name: IconName;
  class?: string;
  label?: string;
}

const { name, class: className, label } = Astro.props;
---

<svg
  class:list={["icon", className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
>
  {PATHS[name].map((d) => <path d={d} />)}
</svg>
