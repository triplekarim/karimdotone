---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import ProjectArt from "./ProjectArt.astro";
import type { Project } from "../../lib/content";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, summary, tags, links, year, cover } = project.data;
const primary = links[0];
---

<article class="project card lift" data-reveal>
  <div class="project-art-wrap">
    {
      cover ? (
        <Image src={cover} alt="" widths={[640, 960, 1280]} sizes="(max-width: 52rem) 100vw, 60vw" class="project-cover" />
      ) : (
        <ProjectArt seed={title} />
      )
    }
    {year && <span class="project-year">{year}</span>}
  </div>
  <div class="project-body">
    <h3>
      {
        primary ? (
          <a href={primary.href} class="stretched" target="_blank" rel="noopener noreferrer">
            {title}
          </a>
        ) : (
          title
        )
      }
    </h3>
    <p class="muted">{summary}</p>
    <ul class="tag-list">
      {tags.map((t) => <li class="tag">{t}</li>)}
    </ul>
    {
      links.length > 0 && (
        <ul class="project-links">
          {links.map((l) => (
            <li>
              <a href={l.href} target="_blank" rel="noopener noreferrer">
                {l.label} <Icon name="arrow-up-right" />
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }

  .project-art-wrap {
    position: relative;
    height: 10.5rem; /* fixed, so wide cards keep the same cover height as narrow ones */
    margin: 0.5rem 0.5rem 0;
    border-radius: calc(var(--r-lg) - 0.5rem);
    overflow: hidden;
  }

  .project-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-art-wrap :global(svg),
  .project-cover {
    transition: transform 1.2s var(--ease-out);
  }

  .project:hover .project-cover,
  .project:hover .project-art-wrap :global(svg) {
    transform: scale(1.05);
  }

  .project-year {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    padding: 0.15rem 0.6rem;
    border-radius: var(--r-pill);
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(6px);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .project-body {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    flex: 1;
    padding: 1.25rem 1.5rem 1.5rem;
  }

  h3 a {
    color: var(--text);
  }

  .stretched::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .project-body > p {
    flex: 1;
    font-size: 0.9375rem;
  }

  .project-links {
    position: relative;
    z-index: 1;
    display: flex;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .project-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
</style>
