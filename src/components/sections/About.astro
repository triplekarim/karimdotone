---
import { Image } from "astro:assets";
import Icon, { type IconName } from "../ui/Icon.astro";
import profile from "../../assets/profile.webp";
import { SITE } from "../../site";
import * as si from "simple-icons";

const facts: { icon: IconName; label: string; value: string }[] = [
  { icon: "cap", label: "Studying", value: "Computer Science" },
  { icon: "pin", label: "Based in", value: SITE.location },
];

const setup: { label: string; value: string }[] = [
  { label: "OS", value: "Fedora KDE Plasma, GrapheneOS" },
  { label: "Browser", value: "Firefox + uBlock Origin + Privacy Badger" },
  { label: "Homelab", value: "Pi 5 8GB (Bought before the apocalypse)" },
];

// Skill badges. `icon` is a simple-icons export (https://simpleicons.org); brands that aren't in
// simple-icons get a two-letter `mark` and a hand-picked `hex` instead. `label` overrides the brand name.
type Skill = { label?: string; hex?: string } & ({ icon: keyof typeof si } | { mark: string; label: string; hex: string });
const skillList: Skill[] = [
  { icon: "siLua" },
  { icon: "siPython" },
  { icon: "siOpenjdk", label: "Java", hex: "ED8B00" },
  { icon: "siTypescript" },
  { icon: "siReact" },
  { icon: "siAstro" },
  { icon: "siGit" },
  { icon: "siDocker" },
  { icon: "siLinux" },
  { icon: "siBlender" },
  { icon: "siRobloxstudio", label: "Roblox Studio" },
  { mark: "Pt", label: "Substance Painter", hex: "F0506E" },
  { mark: "Af", label: "Affinity", hex: "4E9CE0" },
  { icon: "siKicad" },
];

// Brand colours that are too dark to read on the black background get blended toward white.
function readable(hex: string) {
  const [r, g, b] = [0, 2, 4].map((i) => parseInt(hex.slice(i, i + 2), 16));
  const lum = (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255;
  if (lum >= 0.35) return `#${hex}`;
  const t = 0.35 + (0.35 - lum);
  const mix = (c: number) => Math.round(c + (255 - c) * t).toString(16).padStart(2, "0");
  return `#${mix(r)}${mix(g)}${mix(b)}`;
}

const skills = skillList.map((k) => {
  if ("mark" in k) return { label: k.label, mark: k.mark, color: readable(k.hex) };
  const s = si[k.icon] as { title: string; hex: string; path: string };
  return { label: k.label ?? s.title, path: s.path, color: readable(k.hex ?? s.hex) };
});

// size: how big the word is in the cloud. note: optional small aside. href: makes it a (secret) link.
const interests: { name: string; size: "l" | "m" | "s"; note?: string; href?: string }[] = [
  { name: "Linux", size: "s", note: "Fedora, KDE" },
  { name: "anything open source", size: "m"},
  { name: "Self-hosting", size: "l"},
  { name: "Digital sovereignty", size: "s", note: "no more big tech" },
  { name: "Star Wars", size: "s", href: "https://www.youtube.com/watch?v=H9VVkwRb_7M" },
  { name: "Split keyboards", size: "m", note: "mechanical ofc" },
  { name: "Cars", size: "s" },
  { name: "Home Assistant", size: "m" },
  { name: "Soldering", size: "s", note: "(i suck at it tho)"},
  { name: "Tinkering", size: "l" },
  { name: "Women", size: "s" },
  { name: "Ducks", size: "l", href: "/ducks" },
  { name: "right to repair", size: "s" },
  { name: "oldschool hip-hop", size: "m" },

  { name: "Calisthenics", size: "m" },
  { name: "Reading", size: "s" },
];
---

<section id="about" class="section about">
  <div class="ambient" style="left: -22rem; top: 0;" aria-hidden="true"></div>
  <div class="container">
    <div class="section-head" data-reveal>
      <div>
        <p class="section-index">01 — About</p>
        <h2 class="gradient-text">Who I am</h2>
      </div>
    </div>

    <div class="about-grid" data-reveal-stagger>
      <article class="bio" data-reveal>
        <div class="bio-head">
          <div class="photo">
            <Image src={profile} alt="Karim's avatar" width={240} height={240} loading="lazy" />
          </div>
          <div>
            <p class="bio-name">Karim Güzel</p>
            <p class="bio-role">{SITE.role}</p>
          </div>
        </div>

        <div class="bio-text">
          <p class="lead">Hey, I'm Karim. I love creating (anything, really).</p>
          <p>
            I run <a href="https://triplemanta.com" target="_blank" rel="noopener noreferrer">tripleManta</a>, a small studio that makes games and
            sells tools to other roblox devs, like our triton game framework or our state-of-the-art weapon system.
          </p>
          <p>
            The rest of the time I'm usually tinkering: soldering something, bricking my laptop (stay away from arm laptops if you value your sanity) or completely taking apart my car because I found a part in marginally better condition on kleinanzeigen (the german version of facebook marketplace).
          </p>
        </div>

        <dl class="facts">
          {
            facts.map((f) => (
              <div class="fact">
                <span class="fact-icon">
                  <Icon name={f.icon} />
                </span>
                <div>
                  <dt>{f.label}</dt>
                  <dd>{f.value}</dd>
                </div>
              </div>
            ))
          }
        </dl>
      </article>

      <div class="side">
        <aside class="side-card" data-reveal>
          <p class="card-title">My Setup</p>
          <dl class="kv">
            {
              setup.map((s) => (
                <div>
                  <dt>{s.label}</dt>
                  <dd>{s.value}</dd>
                </div>
              ))
            }
          </dl>
        </aside>

        <aside class="side-card" data-reveal>
          <p class="card-title">Skills</p>
          <ul class="skills">
            {
              skills.map((s) => (
                <li class="shield" style={`--brand-raw: ${s.color}`}>
                  <span class="shield-logo">
                    {s.path ? (
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d={s.path} />
                      </svg>
                    ) : (
                      <span class="shield-mark" aria-hidden="true">{s.mark}</span>
                    )}
                  </span>
                  <span class="shield-label">{s.label}</span>
                </li>
              ))
            }
          </ul>
        </aside>
      </div>
    </div>

    <div class="interests" data-reveal>
      <p class="card-title">Things I'm into</p>
      <ul class="cloud">
        {
          interests.map((i, n) => (
            <li class:list={["word", `word-${i.size}`]} data-word>
              <span
                class="word-float"
                style={`--fx: ${((n * 37) % 9) - 4}px; --fy: ${6 + ((n * 53) % 7)}px; --fd: ${5 + ((n * 29) % 5)}s; --fdl: -${(n * 1.3) % 5}s`}
              >
                {i.href ? (
                  <a
                    class="word-name word-link"
                    href={i.href}
                    {...(i.href.startsWith("http") && { target: "_blank", rel: "noopener noreferrer" })}
                  >
                    {i.name}
                  </a>
                ) : (
                  <span class="word-name">{i.name}</span>
                )}
                {i.note && <span class="word-note">{i.note}</span>}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  .bio {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .bio-head {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .photo {
    width: 4.5rem;
    aspect-ratio: 1;
    flex: none;
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--accent-900);
    box-shadow: 0 16px 40px -18px var(--glow);
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bio-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.03em;
  }

  .bio-role {
    color: var(--text-faint);
    font-size: 0.875rem;
  }

  .bio-text {
    display: grid;
    gap: 1rem;
    max-width: 38rem;
    color: var(--text-muted);
  }

  .lead {
    color: var(--text);
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    line-height: 1.45;
    letter-spacing: -0.01em;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin: auto 0 0;
  }

  .fact {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .fact-icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    flex: none;
    border-radius: var(--r-sm);
    background: rgba(109, 40, 217, 0.14);
    color: var(--accent-300);
  }

  dt {
    font-size: 0.75rem;
    color: var(--text-faint);
  }

  dd {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .side {
    display: grid;
    gap: 2.5rem;
    align-content: start;
  }

  .card-title {
    margin-bottom: 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .kv {
    display: grid;
    gap: 0.25rem;
    margin: 0;
  }

  .kv div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0;
  }

  .kv dt {
    font-size: 0.875rem;
  }

  .kv dd {
    text-align: right;
    font-size: 0.875rem;
  }

  /* ---------- skill shields ---------- */
  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .shield {
    /* brand colour pulled toward the muted text grey so the row reads as one palette */
    --brand: color-mix(in oklch, var(--brand-raw) 62%, #8e8b99);
    display: inline-flex;
    align-items: stretch;
    border-radius: var(--r-xs);
    overflow: hidden;
    background: var(--fill-2);
    box-shadow: inset 0 0 0 1px var(--fill-3);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1;
    transition:
      transform var(--dur-fast) var(--ease-spring),
      box-shadow var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out);
  }

  .shield-logo {
    display: grid;
    place-items: center;
    padding: 0.45rem 0.55rem;
    background: color-mix(in srgb, var(--brand) 16%, transparent);
    transition: background var(--dur-fast) var(--ease-out);
  }

  .shield-logo svg {
    width: 0.95rem;
    height: 0.95rem;
    fill: var(--brand);
    transition: fill var(--dur-fast) var(--ease-out);
  }

  .shield-mark {
    display: grid;
    place-items: center;
    width: 0.95rem;
    height: 0.95rem;
    border-radius: 3px;
    background: var(--brand);
    color: var(--bg);
    font-family: var(--font-display);
    font-size: 0.55rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .shield:hover .shield-mark {
    background: var(--bg);
    color: var(--brand);
  }

  .shield-label {
    display: flex;
    align-items: center;
    padding: 0 0.7rem 0 0.6rem;
    color: var(--text-muted);
    letter-spacing: 0.02em;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .shield:hover {
    transform: translateY(-2px);
    background: color-mix(in srgb, var(--brand) 8%, transparent);
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--brand) 35%, transparent),
      0 10px 24px -12px var(--brand);
  }

  .shield:hover .shield-logo {
    background: var(--brand);
  }

  .shield:hover .shield-logo svg {
    fill: var(--bg);
  }

  .shield:hover .shield-label {
    color: var(--text);
  }

  /* ---------- free-form interest cloud ---------- */
  .interests {
    margin-top: clamp(5rem, 10vw, 8rem);
    padding-block: clamp(1rem, 3vw, 2rem);
    text-align: center;
  }

  .interests .card-title {
    margin-bottom: 2rem;
  }

  .cloud {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1rem 2.5rem;
    max-width: 60rem;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .word {
    display: inline-flex;
    will-change: transform;
  }

  /* slow idle drift; each word gets its own offset, duration and phase */
  .word-float {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    animation: float var(--fd, 6s) ease-in-out var(--fdl, 0s) infinite alternate;
  }

  @keyframes float {
    from {
      transform: translate(calc(var(--fx) * -1), calc(var(--fy) * -0.5));
    }
    to {
      transform: translate(var(--fx), var(--fy));
    }
  }

  .word-name {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.1;
    color: var(--text-muted);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .word:hover .word-name {
    color: var(--text);
  }

  /* easter eggs: look like every other word until hovered */
  .word-link {
    text-decoration: none;
  }

  .word .word-link:hover,
  .word .word-link:focus-visible {
    color: var(--accent-400);
  }

  .word-l .word-name {
    font-size: clamp(2.25rem, 5.5vw, 3.75rem);
    color: var(--text);
  }

  .word-m .word-name {
    font-size: clamp(1.5rem, 3.2vw, 2.25rem);
  }

  .word-s .word-name {
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    color: var(--text-faint);
  }

  .word-note {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-faint);
    white-space: nowrap;
  }

  @media (max-width: 52rem) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .word-float {
      animation: none;
    }
  }
</style>

<script>
  // Words in the interest cloud get nudged away from the cursor, then spring back.
  const RADIUS = 180; // px of influence around the pointer
  const PUSH = 14; // max displacement in px
  const CORE = 70; // px; push fades out near the word's centre so hovering it stays calm

  let cleanup: (() => void) | undefined;

  function init() {
    cleanup?.();
    cleanup = undefined;
    const cloud = document.querySelector<HTMLElement>(".cloud");
    if (!cloud || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    if (!matchMedia("(pointer: fine)").matches) return;

    const words = [...cloud.querySelectorAll<HTMLElement>("[data-word]")].map((el) => ({
      el,
      x: 0,
      y: 0,
      vx: 0,
      vy: 0,
      tx: 0,
      ty: 0,
    }));
    let pointer: { x: number; y: number } | null = null;
    let raf = 0;
    let visible = false;

    const tick = () => {
      raf = 0;
      let moving = false;
      for (const w of words) {
        w.tx = 0;
        w.ty = 0;
        if (pointer) {
          // centre of the word in its resting position
          const r = w.el.getBoundingClientRect();
          const cx = r.left + r.width / 2 - w.x;
          const cy = r.top + r.height / 2 - w.y;
          const dx = cx - pointer.x;
          const dy = cy - pointer.y;
          const d = Math.hypot(dx, dy) || 1;
          const t = Math.max(0, 1 - d / RADIUS);
          const f = t * t * (3 - 2 * t) * (d / (d + CORE));
          w.tx = (dx / d) * PUSH * f;
          w.ty = (dy / d) * PUSH * f;
        }
        // damped spring toward the target
        w.vx = (w.vx + (w.tx - w.x) * 0.05) * 0.86;
        w.vy = (w.vy + (w.ty - w.y) * 0.05) * 0.86;
        w.x += w.vx;
        w.y += w.vy;
        if (Math.abs(w.vx) + Math.abs(w.vy) + Math.abs(w.tx - w.x) + Math.abs(w.ty - w.y) > 0.05) moving = true;
        w.el.style.transform = `translate(${w.x.toFixed(2)}px, ${w.y.toFixed(2)}px)`;
      }
      if (moving && visible) raf = requestAnimationFrame(tick);
    };
    const wake = () => {
      if (!raf && visible) raf = requestAnimationFrame(tick);
    };

    const onMove = (e: PointerEvent) => {
      pointer = { x: e.clientX, y: e.clientY };
      wake();
    };
    const onLeave = () => {
      pointer = null;
      wake();
    };

    const io = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) wake();
    });
    io.observe(cloud);
    window.addEventListener("pointermove", onMove, { passive: true });
    document.documentElement.addEventListener("pointerleave", onLeave);

    cleanup = () => {
      cancelAnimationFrame(raf);
      io.disconnect();
      window.removeEventListener("pointermove", onMove);
      document.documentElement.removeEventListener("pointerleave", onLeave);
    };
  }

  init();
  document.addEventListener("astro:page-load", init);
  document.addEventListener("astro:before-swap", () => {
    cleanup?.();
    cleanup = undefined;
  });
</script>
